# Loaded by test/setup.js for every vitest run. Points at a SEPARATE database
# (pitchpulse_test) so a test run never touches dev data. Create + migrate it
# once with `npm run test:db` (or it runs automatically via `pretest`).
DATABASE_URL=postgresql://pitchpulse:pitchpulse@localhost:5434/pitchpulse_test?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=test-secret-not-used-in-production
CRICKET_API_KEY=
PORT=3001

# Keep the background machinery quiet — the suites that need it drive it
# explicitly with vi.stubEnv.
POLL_ENABLED=false
NOTIFICATIONS_ENABLED=false
LOG_LEVEL=silent
