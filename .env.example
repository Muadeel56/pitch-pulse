# --- Connection URLs: two forms, pick per how you run the app ---
# Local (npm run dev, against the compose postgres+redis):
#   DATABASE_URL=postgresql://pitchpulse:pitchpulse@localhost:5434/pitchpulse?schema=public
#   REDIS_URL=redis://localhost:6379
# Inside `docker compose` the app container reaches the other services by
# SERVICE NAME, not localhost:
#   DATABASE_URL=postgresql://pitchpulse:pitchpulse@postgres:5432/pitchpulse?schema=public
#   REDIS_URL=redis://redis:6379
# docker-compose.yml overrides DATABASE_URL/REDIS_URL to the service-name form,
# so this file can keep the localhost form below for host-side tooling.
DATABASE_URL=postgresql://pitchpulse:pitchpulse@localhost:5434/pitchpulse?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
PORT=3000

# --- Structured logging (Phase 10) ---
# pino levels: trace|debug|info|warn|error|fatal. `debug` messages only show at
# LOG_LEVEL=debug. Pretty-printed unless NODE_ENV=production (then JSON lines).
LOG_LEVEL=info

# --- Our own API rate limit (Phase 10, @fastify/rate-limit) ---
# Per key (user id when authenticated, else IP). /health and /ready are exempt.
# /auth/login and /auth/signup have a tighter built-in limit (10 / 5 minutes).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"

# --- Docker (Phase 9) ---
# Set to true for the FIRST `docker compose up` to seed Teams/Players, then put
# it back to false so restarts don't re-run the seed.
RUN_DB_SEED=false

# --- Cricket API client (Phase 3) ---
# Empty -> the mock data provider (evolving scores, on-demand failure injection).
# Set -> real HTTP provider (fetch) against CRICKET_API_BASE_URL.
CRICKET_API_KEY=
CRICKET_API_BASE_URL=https://api.cricapi.com/v1
CRICKET_API_TIMEOUT_MS=8000
CRICKET_API_MAX_RETRIES=3
CRICKET_API_MIN_INTERVAL_MS=1000
# Force a failure from the mock provider for demos/tests:
# "<kind>[:<mode>[:<n>]]", kind = timeout|429|500|malformed, mode = once|always|everyNth
# CRICKET_MOCK_FAIL=500:always

# --- Background polling job (Phase 4) ---
# Set POLL_ENABLED=false to run an app instance that does not poll (or in tests).
POLL_ENABLED=true
POLL_INTERVAL_MS=45000        # clamped to 30000-60000
POLL_LOCK_TTL_MS=30000

# --- Caching layer (Phase 5) ---
# TTL (seconds) on every cached match key (match:live:list, match:detail:{id}).
# Safety net for a stalled poll job — the poll job is the only writer, so keep
# this comfortably > POLL_INTERVAL_MS or a single slow poll could expire it.
# Clamped to a 30s floor.
CACHE_TTL_SECONDS=120

# --- Real-time push (Phase 6) ---
# CORS origin for the Socket.io server. "*" is fine for local dev / the test
# client at GET /client; lock this down before any real deployment.
SOCKET_CORS_ORIGIN=*

# --- Event-driven notifications (Phase 7) ---
# Set NOTIFICATIONS_ENABLED=false to run an app instance that derives no
# semantic events into persisted Notification rows (e.g. a second process, or
# tests). Read once at startup.
NOTIFICATIONS_ENABLED=true
